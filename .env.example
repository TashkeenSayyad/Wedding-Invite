# Copy this to .env and fill in the two settings that make the RSVP work. Values here win over
# the defaults in src/config.js, so you never have to edit source. Rebuild after changing them:
#
#     cp .env.example .env      # then edit .env
#     npm run build
#
# .env is not committed. If you would rather keep the settings in the repository, put them in
# src/config.js instead and leave this alone.

# The family WhatsApp number: country code first, digits only, no + and no spaces.
# Left blank, the RSVP still composes its message but WhatsApp asks the guest to choose a
# contact — so replies arrive addressed to nobody.
VITE_RSVP_PHONE=

# The Google Apps Script web app URL, ending in /exec. scripts/rsvp-sheet.gs is the script and
# carries its own five-minute setup. Left blank, replies queue on each guest's phone and only
# WhatsApp carries them.
VITE_RSVP_ENDPOINT=

# Where the invitation is published. Only change this if you move it off GitHub Pages or rename
# the repository — the guest links and the QR code are built from it.
VITE_SITE=https://tashkeensayyad.github.io/Wedding-Invite/
